@model ErrorViewModel
@{
    ViewData["Title"] = "Error";
}

<h2 style="color:#ff5050">An error occurred</h2>
<p>Something went wrong while processing the request.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

<p>
    For a detailed message, run the editor with <code>ASPNETCORE_ENVIRONMENT=Development</code>.
</p>
<p><a href="/" style="color:#ff8000">Back to the editor</a></p>
