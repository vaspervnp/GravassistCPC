@model ErrorViewModel
@{
    ViewData["Title"] = "Σφάλμα";
}

<h2 style="color:#ff5050">Παρουσιάστηκε σφάλμα</h2>
<p>Κάτι πήγε στραβά κατά την επεξεργασία του αιτήματος.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID:</strong> <code>@Model.RequestId</code></p>
}

<p>
    Για αναλυτικό μήνυμα, τρέξε τον editor με <code>ASPNETCORE_ENVIRONMENT=Development</code>.
</p>
<p><a href="/" style="color:#ff8000">Επιστροφή στον επεξεργαστή</a></p>
