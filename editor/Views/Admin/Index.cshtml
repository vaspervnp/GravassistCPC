@model IReadOnlyList<GravassistEditor.Services.Account>
@{
    ViewData["Title"] = "Accounts";
    var pending = Model.Where(a => !a.Allowed).ToList();
    var allowed = Model.Where(a => a.Allowed).ToList();
}

<style>
    .adm { display: grid; gap: 16px; max-width: 720px; }
    .adm table { border-collapse: collapse; width: 100%; font-size: 12px; }
    .adm th, .adm td { text-align: left; padding: 5px 8px;
                       border-bottom: 1px solid var(--line); }
    .adm th { color: var(--edge); font-weight: normal; letter-spacing: 1px; }
    .adm .who { color: var(--ink); }
    .adm .note { color: #8a8ac0; }
    .adm form.row { display: inline; }
    .adm .msg { color: var(--material); }
</style>

<div class="adm">
    <div class="panel">
        <h2>Invite an account</h2>
        <form method="post" asp-action="Invite" class="toolbar">
            @Html.AntiForgeryToken()
            <input type="email" name="email" placeholder="name@example.com"
                   required style="min-width:16rem" />
            <button type="submit">Invite</button>
        </form>
        <div class="hintline">
            An invited account can sign in straight away and is emailed a link.
            Anyone who signs in without an invitation lands in <b>Waiting</b>
            below &mdash; they cannot use the editor until you approve them, and
            no folder is created for them.
        </div>
        <div class="hintline">
            @if (ViewData["Mail"] is true)
            {
                <span>Mail is configured, so sign-in codes and invitations go out
                      by email.</span>
                <form method="post" asp-action="MailTest" class="row">
                    @Html.AntiForgeryToken()
                    <button type="submit">Send me a test message</button>
                </form>
            }
            else
            {
                <b>No mail settings.</b>
                <span>
                    Signing in by email is switched off and invitations are not
                    delivered &mdash; you have to pass the link on yourself. Set
                    <code>gravassistSmtpHost</code>, <code>gravassistSmtpPort</code>,
                    <code>gravassistSmtpUser</code>, <code>gravassistSmtpPass</code>
                    and <code>gravassistMailFrom</code> in the environment, then
                    restart the editor.
                </span>
            }
        </div>
        @if (TempData["Msg"] is string msg)
        {
            <div class="msg">@msg</div>
        }
    </div>

    <div class="panel">
        <h2>Waiting for approval (@pending.Count)</h2>
        @if (pending.Count == 0)
        {
            <div class="hintline" style="margin-top:0">Nobody is waiting.</div>
        }
        else
        {
            <table>
                <tr><th>Account</th><th>Since</th><th></th></tr>
                @foreach (var a in pending)
                {
                    <tr>
                        <td class="who">@a.Email</td>
                        <td class="note">@a.Seen.ToString("yyyy-MM-dd HH:mm") UTC</td>
                        <td>
                            <form method="post" asp-action="Approve" class="row">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="email" value="@a.Email" />
                                <button type="submit">Approve</button>
                            </form>
                        </td>
                    </tr>
                }
            </table>
        }
    </div>

    <div class="panel">
        <h2>Allowed (@(allowed.Count + 1))</h2>
        <table>
            <tr><th>Account</th><th>How</th><th>Publish</th><th></th></tr>
            <tr>
                <td class="who">@ViewData["Admin"]</td>
                <td class="note">administrator</td>
                <td class="note">always</td>
                <td></td>
            </tr>
            @foreach (var a in allowed)
            {
                <tr>
                    <td class="who">@a.Email</td>
                    <td class="note">@a.Note</td>
                    <td>
                        <form method="post" asp-action="Publish" class="row">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@a.Email" />
                            <input type="hidden" name="allow" value="@((!a.Publish).ToString().ToLowerInvariant())" />
                            <button type="submit">@(a.Publish ? "on — turn off" : "off — turn on")</button>
                        </form>
                    </td>
                    <td>
                        <form method="post" asp-action="Revoke" class="row">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="email" value="@a.Email" />
                            <button type="submit">Revoke</button>
                        </form>
                    </td>
                </tr>
            }
        </table>
        <div class="hintline">
            <b>Publish</b> lets that account copy its own rooms over the shared
            <code>levels/</code> folder &mdash; the files git tracks, and the
            ones every new account is seeded from. Everyone can design rooms in
            their own folder; only these accounts can overwrite what everybody
            sees. Off by default.
        </div>
        <div class="hintline">
            Revoking keeps the account&rsquo;s folder under <code>levels/</code>
            &mdash; it only stops them signing in. The administrator cannot be
            revoked, otherwise one wrong click would lock out the only person
            who can unlock it.
        </div>
    </div>

    <div><a href="/">&larr; Back to the editor</a></div>
</div>
