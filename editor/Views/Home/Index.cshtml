@using System.Text.Json
@model EditorViewModel
@{
    ViewData["Title"] = "Level editor";
    ViewData["LevelsPath"] = Model.LevelsPath;

    // Τα σχήματα των κελιών γράφονται στο TileType με τα σύμβολα var(--fill)/var(--edge)·
    // εδώ αντικαθίστανται με τα πραγματικά χρώματα του τύπου, ώστε το SVG να μην
    // εξαρτάται από κληρονομικότητα CSS μεταβλητών μέσα σε <use> shadow tree.
    Func<TileType, string> bake = t => t.Svg
        .Replace("var(--fill)", t.Fill)
        .Replace("var(--edge)", t.Edge);

    // Ό,τι χρειάζεται το JS: τύποι κελιών + σταθερές του πλέγματος.
    var tileJson = JsonSerializer.Serialize(new
    {
        cols = Model.Cols,
        rows = Model.Rows,
        empty = Model.EmptySymbol.ToString(),
        solid = Model.SolidSymbol.ToString(),
        exit = Model.ExitSymbol.ToString(),
        teleport = Model.TeleportSymbol.ToString(),
        start = Model.StartSymbol.ToString(),
        tiles = Model.Tiles.Select(t => new
        {
            id = t.Id,
            symbol = t.Symbol.ToString(),
            name = t.Name,
            hint = t.Hint,
        }),
    });

    // Ετικέτα αρχείου στη λίστα: οι αίθουσες δείχνουν τον αριθμό τους.
    Func<LevelFileInfo, string> fileLabel = f =>
        f.Room is null ? f.Name : $"Room {f.Room} — {f.Name}";
}

<style>
    /* Τα εργαλεία πάνω, σε στήλες· η πίστα και το πηγαίο της από κάτω.
       Οι στήλες προσαρμόζονται στο πλάτος: σε στενή οθόνη γίνονται μία. */
    .workbench {
        display: flex;
        flex-direction: column;
        gap: 20px;
    }

    .toolcols {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
        gap: 14px;
        align-items: start;
    }

    /* Χωρίς αυτό, το μεγάλο min-content πλάτος των βοηθητικών κειμένων
       φουσκώνει τις στήλες και το πλέγμα καταρρέει σε μία. */
    .toolcols > .panel { min-width: 0; }
    .toolcols .hintline { overflow-wrap: anywhere; }

    /* Η παλέτα τύπων δίπλα στην πίστα: τη χρησιμοποιείς ΕΝΩ ζωγραφίζεις, οπότε
       η απόσταση από το πλέγμα είναι που μετράει. Σε στενή οθόνη πέφτει από
       κάτω και απλώνεται σε στήλες, ώστε να μη γίνεται ατέλειωτη λίστα. */
    .stagerow {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 340px;
        gap: 16px;
        align-items: start;
    }

    /* ΠΡΟΣΟΧΗ: το περίβλημα ΔΕΝ παίρνει την κλάση .palette — αυτή είναι πλέγμα
       δύο στηλών, οπότε το περίβλημα θα γινόταν κι αυτό πλέγμα και οι εσωτερικές
       ομάδες κουμπιών θα έπιαναν τη μία από τις δύο στήλες: μισό πλάτος και ένα
       μεγάλο κενό δεξιά. */
    .panel.tilebox { position: sticky; top: 12px; max-height: 82vh; overflow-y: auto; }

    /* Τα κουμπιά γεμίζουν ΟΛΟ το πλάτος του πάνελ: όσες στήλες χωρέσουν με
       ελάχιστο πλάτος που να μη σπάει η ετικέτα. */
    .panel.tilebox .palette { grid-template-columns: repeat(auto-fill, minmax(128px, 1fr)); }

    @@media (max-width: 1000px) {
        .stagerow { grid-template-columns: 1fr; }
        .panel.tilebox { position: static; max-height: none; }
    }

    .panel {
        border: 1px solid var(--line);
        background: var(--chrome-2);
        padding: 10px;
    }

    .panel h2 {
        margin: 0 0 8px;
        font-size: 12px;
        letter-spacing: 1.5px;
        color: var(--edge);
        text-transform: uppercase;
    }

    .panel h3.group {
        margin: 10px 0 5px;
        font-size: 11px;
        font-weight: normal;
        color: #8a8ac0;
        letter-spacing: 1px;
        border-bottom: 1px solid var(--line);
        padding-bottom: 2px;
    }

    .panel h3.group:first-of-type { margin-top: 0; }

    .palette {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 5px;
    }

    .palette button {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 4px 6px;
        text-align: left;
        overflow: hidden;
    }

    .palette svg {
        flex: 0 0 auto;
        background: var(--bg);
        border: 1px solid var(--line);
    }

    .palette .label {
        font-size: 11px;
        line-height: 1.2;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .palette .key { color: #8a8ac0; }

    .toolbar, .filebar {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .filebar select, .filebar input[type=text] { flex: 1 1 100%; }

    .stage {
        min-width: 0;
    }

    #grid {
        width: 100%;
        max-width: 1280px;
        display: block;
        background: var(--bg);
        border: 2px solid var(--edge);
        touch-action: none;
        cursor: crosshair;
    }

    /* Οι γραμμές του πλέγματος πρέπει να μένουν 1 pixel οθόνης όσο κι αν μεγαλώσει
       το SVG — χωρίς αυτό το πάχος κλιμακώνεται μαζί με το viewBox και εξαφανίζεται. */
    #gridlines line {
        vector-effect: non-scaling-stroke;
        stroke-width: 1;
    }

    .status {
        margin-top: 10px;
        min-height: 22px;
        font-size: 13px;
    }

    .status.ok { color: var(--material); }
    .status.err { color: #ff5050; }
    .status.warn { color: #ffd000; }
    .status.info { color: #8a8ac0; }

    .readout {
        margin-top: 6px;
        font-size: 12px;
        color: #8a8ac0;
    }

    details.source pre {
        margin: 6px 0 0;
        padding: 8px;
        background: #000;
        color: var(--material);
        font-size: 11px;
        line-height: 1.25;
        overflow-x: auto;
        white-space: pre;
    }

    .hintline {
        font-size: 11px;
        color: #8a8ac0;
        margin-top: 8px;
    }

    /* --- Πίνακες συνδέσεων (έξοδοι & τηλεμεταφορές) --- */
    .link-row {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 6px;
        padding: 4px 0;
        border-bottom: 1px solid var(--line);
        font-size: 11px;
    }

    /* Η πόρτα έχει τέσσερα χειριστήρια (αίθουσα, διπλή, δύο συντεταγμένες
       άφιξης) και δεν χωράνε σε μία σειρά στη στήλη του πάνελ. Η άφιξη πάει
       πάντα σε δική της γραμμή αντί να στριμώχνεται όπου τύχει. */
    .link-arr {
        flex: 1 0 100%;
        display: flex;
        align-items: center;
        gap: 6px;
        padding-left: 26px;
        color: #8a8ac0;
    }

    .link-row:last-child { border-bottom: none; }

    .link-tag {
        flex: 0 0 auto;
        min-width: 20px;
        text-align: center;
        padding: 1px 4px;
        border: 1px solid var(--edge);
        color: var(--edge);
    }

    .link-pos { flex: 1 1 auto; color: #8a8ac0; white-space: nowrap; }

    .link-row input[type=number] {
        flex: 0 0 62px;
        font: inherit;
        font-size: 12px;
        color: var(--ink);
        background: var(--chrome-2);
        border: 1px solid var(--line);
        padding: 3px 4px;
    }

    /* Στις τηλεμεταφορές χωράνε δύο πεδία (στήλη + γραμμή) και ένα κουμπί. */
    .link-row input.coord { flex: 0 0 44px; }

    .link-row button.pick {
        flex: 0 0 auto;
        padding: 2px 5px;
        font-size: 11px;
    }

    .link-row.missing input[type=number] { border-color: #ff5050; }
    .link-row.unknown input[type=number] { border-color: #ffd000; }

    /* Ομάδα τηλεμεταφοράς χωρίς προορισμό: προειδοποίηση, όχι σφάλμα. */
    .link-row.pending input[type=number] { border-color: #ffd000; }
    .link-two { display:flex; align-items:center; gap:.25rem; font-size:.85em;
                color:#9ab; white-space:nowrap; cursor:pointer; }

    .link-row.picking {
        background: rgba(255, 128, 0, 0.18);
        outline: 1px solid var(--edge);
    }

    .link-note { font-size: 11px; margin-top: 6px; }
    .link-note.err { color: #ff5050; }
    .link-note.warn { color: #ffd000; }

    /* Οι ετικέτες/βέλη πάνω στο πλέγμα δεν πρέπει να πιάνουν το ποντίκι. */
    #exit-labels, #tp-labels, #tp-links { pointer-events: none; }

    /* Κατάσταση «διάλεξε κελί προορισμού»: αλλάζει ο δείκτης πάνω από το πλέγμα. */
    #grid.picking { cursor: cell; }
</style>

<script id="editor-data" type="application/json">@Html.Raw(tileJson)</script>

<div class="workbench">
    <div class="toolcols">
        <div class="panel">
            <h2>File</h2>
            <div class="filebar">
                <select id="file-list" title="Levels in the levels/ folder">
                    @foreach (var f in Model.Files)
                    {
                        <option value="@f.Name">@fileLabel(f)</option>
                    }
                </select>
                <button id="btn-open" type="button">Open</button>
                <button id="btn-new" type="button">New</button>
                <button id="btn-new-room" type="button"
                        title="Creates levels/room_&lt;N&gt;.txt with the next free number">
                    New room
                </button>
                <button id="btn-copy-room" type="button"
                        title="Copies the open room to the next free number">
                    Copy
                </button>
                <input type="number" id="room-target" min="1" max="9999" step="1"
                       placeholder="to #" title="New room number for Move" />
                <button id="btn-move-room" type="button"
                        title="Changes the room number and updates every door that points to it">
                    Move
                </button>
                <button id="btn-play" type="button"
                        title="Runs the room in the browser, with the same physics">
                    Test
                </button>
                <button id="btn-dsk" type="button"
                        title="Builds build/gravassist.dsk starting from this room">
                    Build .dsk
                </button>
                <input type="text" id="file-name" placeholder="name.txt" />
                <button id="btn-save" type="button">Save</button>
            </div>
            <div class="hintline">The levels folder is the repo's <code>levels/</code>.
                Rooms are <code>room_&lt;N&gt;.txt</code> files.</div>
        </div>

        <div class="panel">
            <h2>Exits</h2>
            <div id="exit-list"></div>
            <div class="link-note" id="exit-note"></div>
            <div class="hintline">
                Adjacent <code>X</code> cells (up/down/left/right) count as ONE
                exit and lead to the same room. Each group writes one
                <code>exit &lt;col&gt; &lt;row&gt; &lt;room&gt;</code> line in the file footer.
            </div>
        </div>

        <div class="panel">
            <h2>Teleporters</h2>
            <div id="tp-list"></div>
            <div class="link-note" id="tp-note"></div>
            <div class="hintline">
                Adjacent <code>T</code> cells count as ONE teleporter and lead
                to the same cell of the SAME room. "Set" = pick the destination cell
                by clicking on the grid (<kbd>Esc</kbd> cancels); the col/row fields
                also accept typing. Each group writes one
                <code>tp &lt;col&gt; &lt;row&gt; &lt;dcol&gt; &lt;drow&gt;</code> line.
                A teleporter with no destination does nothing in the game.
            </div>
        </div>

        <div class="panel">
            <h2>Tools</h2>
            <div class="toolbar">
                <button type="button" class="tool-btn" data-tool="brush">Brush</button>
                <button type="button" class="tool-btn" data-tool="eraser">Eraser</button>
                <button type="button" class="tool-btn" data-tool="fill">Fill</button>
            </div>
            <div class="toolbar" style="margin-top:6px">
                <button type="button" id="btn-border">Border</button>
                <button type="button" id="btn-clear">Clear</button>
                <button type="button" id="btn-undo">Undo</button>
                <button type="button" id="btn-redo">Redo</button>
            </div>
            <div class="toolbar" style="margin-top:6px">
                <button type="button" id="btn-gridlines" class="active">Grid</button>
            </div>
            <div class="hintline">
                Right click = erase. Pressing the character itself (e.g. <code>#</code>,
                <code>/</code>, <code>k</code>) selects that type. Ctrl+Z / Ctrl+Y = undo / redo.
            </div>
        </div>
    </div>

    <div class="stagerow">
    <div class="stage">
        <svg id="grid" viewBox="0 0 @(Model.Cols * 8) @(Model.Rows * 8)"
             preserveAspectRatio="xMidYMid meet" role="img"
             aria-label="Level grid @Model.Cols by @Model.Rows">
            <defs>
                @* Ένα <symbol> ανά τύπο κελιού, σε συντεταγμένες 8x8 = ένα tile του CPC. *@
                @foreach (var t in Model.Tiles)
                {
                    <symbol id="t-@t.Id" viewBox="0 0 8 8">@Html.Raw(bake(t))</symbol>
                }
                @* Μύτη του βέλους τηλεμεταφοράς — δείχνει προς το κελί προορισμού. *@
                <marker id="tp-arrow" viewBox="0 0 10 10" refX="9" refY="5"
                        markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                    <path d="M0,1 L10,5 L0,9 z" fill="#ff8000"></path>
                </marker>
                @* Μύτη του βέλους άφιξης — δείχνει πού βγαίνει ο παίκτης από την πόρτα. *@
                <marker id="exit-arrow" viewBox="0 0 10 10" refX="9" refY="5"
                        markerWidth="5" markerHeight="5" orient="auto-start-reverse">
                    <path d="M0,1 L10,5 L0,9 z" fill="#00ff00"></path>
                </marker>
            </defs>
            <g id="cells"></g>
            <g id="gridlines" stroke="#ffffff" stroke-opacity="0.22" stroke-width="0.12"></g>
            @* Βέλος από την επιλεγμένη τηλεμεταφορά προς το κελί προορισμού της. *@
            <g id="tp-links"></g>
            @* Βέλος από την επιλεγμένη πόρτα προς το σημείο άφιξής της. *@
            <g id="exit-links"></g>
            @* Ο αριθμός αίθουσας προορισμού, γραμμένος πάνω σε κάθε κελί της ομάδας. *@
            <g id="exit-labels" font-size="5" font-family="monospace" font-weight="bold"
               text-anchor="middle" stroke="#000000" stroke-width="1.2"
               paint-order="stroke" stroke-linejoin="round"></g>
            @* Ο αύξων αριθμός κάθε τηλεμεταφοράς, πάνω σε κάθε κελί της ομάδας. *@
            <g id="tp-labels" font-size="5" font-family="monospace" font-weight="bold"
               text-anchor="middle" stroke="#000000" stroke-width="1.2"
               paint-order="stroke" stroke-linejoin="round"></g>
            <rect id="cursor" width="8" height="8" fill="none"
                  stroke="#ffffff" stroke-width="0.4" pointer-events="none" visibility="hidden"></rect>
        </svg>

        <div class="status info" id="status">Ready.</div>
        <div class="readout" id="readout">—</div>

    </div>

        <div class="panel tilebox">
            <h2>Cell types</h2>
            @foreach (var group in Model.Tiles.GroupBy(t => t.Group))
            {
                <h3 class="group">@group.Key</h3>
                <div class="palette">
                    @foreach (var t in group)
                    {
                        <button type="button" class="tile-btn" data-symbol="@t.Symbol"
                                title="@t.Name — @t.Hint (character '@t.Symbol')">
                            <svg viewBox="0 0 8 8" width="26" height="26" aria-hidden="true">
                                <use href="#t-@t.Id" width="8" height="8"></use>
                            </svg>
                            <span class="label">@t.Name<br /><span class="key">@t.Symbol</span></span>
                        </button>
                    }
                </div>
            }
        </div>
    </div>

    <details class="source" open>
        <summary>Level source text</summary>
        <pre id="source-view"></pre>
    </details>
</div>

<script>
    "use strict";
    (function () {
        // --- Δεδομένα από τον server (ο κατάλογος τύπων ζει στο Models/TileType.cs) ---
        const DATA = JSON.parse(document.getElementById("editor-data").textContent);
        const COLS = DATA.cols, ROWS = DATA.rows;
        const EMPTY = DATA.empty, SOLID = DATA.solid;
        const EXIT = DATA.exit, START = DATA.start, TELE = DATA.teleport;
        const CELL = 8;                       // μονάδες SVG ανά κελί (= 8x8 pixel του CPC)
        const SVGNS = "http://www.w3.org/2000/svg";
        const TILE_BY_SYMBOL = new Map(DATA.tiles.map(t => [t.symbol, t]));

        const svg = document.getElementById("grid");
        const cellsGroup = document.getElementById("cells");
        const gridlines = document.getElementById("gridlines");
        const exitLabels = document.getElementById("exit-labels");
        const teleLabels = document.getElementById("tp-labels");
        const teleLinks = document.getElementById("tp-links");
        const exitLinks = document.getElementById("exit-links");
        const cursor = document.getElementById("cursor");
        const statusEl = document.getElementById("status");
        const readoutEl = document.getElementById("readout");
        const sourceView = document.getElementById("source-view");
        const fileList = document.getElementById("file-list");
        const fileName = document.getElementById("file-name");
        const exitListEl = document.getElementById("exit-list");
        const exitNoteEl = document.getElementById("exit-note");
        const teleListEl = document.getElementById("tp-list");
        const teleNoteEl = document.getElementById("tp-note");

        // --- Κατάσταση -------------------------------------------------
        let grid = [];             // grid[row][col] = χαρακτήρας
        let header = [];           // γραμμές σχολίων κεφαλής (διατηρούνται αυτούσιες)
        let footer = [];
        let currentSymbol = SOLID;
        let currentTool = "brush";
        let painting = false;
        let paintSymbol = EMPTY;
        let dirty = false;
        const undoStack = [], redoStack = [];

        // Προορισμοί εξόδων. Κλειδί = "col,row" ΚΑΘΕ κελιού εξόδου, τιμή = αριθμός
        // αίθουσας (ή null). Κρατάμε την τιμή σε όλα τα κελιά της ομάδας, όχι μόνο
        // στο αναγνωριστικό της: έτσι ο προορισμός επιβιώνει όταν ο χρήστης
        // μεγαλώσει την ομάδα προς τα πάνω/αριστερά και το αναγνωριστικό μετακινηθεί.
        let exitRooms = new Map();
        // Οι δύο άλλες ιδιότητες της πόρτας ζουν ΚΙ ΑΥΤΕΣ ανά κελί, για τον ίδιο
        // λόγο: τα g.* του exitGroups ξαναχτίζονται σε κάθε syncExits() και ό,τι
        // κρατηθεί μόνο εκεί χάνεται με την πρώτη πινελιά στο πλέγμα.
        let exitTwo = new Map();          // cellKey -> διπλής κατεύθυνσης;
        let exitArrive = new Map();       // cellKey -> [col,row] άφιξης ή null
        let exitGroups = [];              // [{col,row,cells:[[c,r],…],room,twoWay,arrive}]
        let knownRooms = new Set();       // αριθμοί αιθουσών που υπάρχουν ως αρχεία

        // Προορισμοί τηλεμεταφορών, με την ΙΔΙΑ λογική: κλειδί = "col,row" κάθε
        // κελιού 'T' της ομάδας, τιμή = [dcol,drow] ή null. Ο προορισμός επιβιώνει
        // όταν η ομάδα μεγαλώσει και μετακινηθεί το αναγνωριστικό της.
        let teleDests = new Map();
        let teleGroups = [];              // [{col,row,cells:[[c,r],…],dest:[c,r]|null}]

        // Κατάσταση «διάλεξε κελί στο πλέγμα». Δύο πίνακες τη χρησιμοποιούν —
        // ο προορισμός τηλεμεταφοράς και το σημείο άφιξης πόρτας — γι' αυτό
        // χρειάζεται και ΕΙΔΟΣ: σκέτος δείκτης θα έδειχνε σε λάθος λίστα.
        let pickKind = null;              // "tp" | "exit" | null
        let pickIndex = null;
        // Ποια σειρά δείχνει βέλος στο πλέγμα (hover ή επιλογή).
        let teleHighlight = null;
        let exitHighlight = null;

        function cellKey(c, r) { return c + "," + r; }

        // Ένα <use> ανά κελί· η αλλαγή τύπου είναι απλή αλλαγή του href.
        const cellNodes = [];

        function setStatus(text, kind) {
            statusEl.textContent = text;
            statusEl.className = "status " + (kind || "info");
        }

        // --- Στήσιμο του πλέγματος -------------------------------------
        function buildGrid() {
            const frag = document.createDocumentFragment();
            for (let r = 0; r < ROWS; r++) {
                cellNodes.push([]);
                for (let c = 0; c < COLS; c++) {
                    const use = document.createElementNS("http://www.w3.org/2000/svg", "use");
                    use.setAttribute("x", c * CELL);
                    use.setAttribute("y", r * CELL);
                    use.setAttribute("width", CELL);
                    use.setAttribute("height", CELL);
                    frag.appendChild(use);
                    cellNodes[r].push(use);
                }
            }
            cellsGroup.appendChild(frag);

            const lines = document.createDocumentFragment();
            for (let c = 0; c <= COLS; c++) {
                const l = document.createElementNS("http://www.w3.org/2000/svg", "line");
                l.setAttribute("x1", c * CELL); l.setAttribute("y1", 0);
                l.setAttribute("x2", c * CELL); l.setAttribute("y2", ROWS * CELL);
                lines.appendChild(l);
            }
            for (let r = 0; r <= ROWS; r++) {
                const l = document.createElementNS("http://www.w3.org/2000/svg", "line");
                l.setAttribute("x1", 0); l.setAttribute("y1", r * CELL);
                l.setAttribute("x2", COLS * CELL); l.setAttribute("y2", r * CELL);
                lines.appendChild(l);
            }
            gridlines.appendChild(lines);
        }

        function drawCell(r, c) {
            const tile = TILE_BY_SYMBOL.get(grid[r][c]);
            cellNodes[r][c].setAttribute("href", "#t-" + (tile ? tile.id : "empty"));
        }

        function drawAll() {
            for (let r = 0; r < ROWS; r++) {
                for (let c = 0; c < COLS; c++) drawCell(r, c);
            }
            refreshSource();
        }

        function refreshSource() {
            sourceView.textContent = grid.map(row => row.join("")).join("\n");
            syncLinks();
        }

        // --- Ομάδες κελιών ----------------------------------------------
        // Ίδιος κανόνας με το CellGroups.Find του Models/RoomLinks.cs και το
        // Room._groups_of του tools/physics.py: γειτονικά κελιά του ίδιου χαρακτήρα
        // σε γειτνίαση 4 αποτελούν ΕΝΑ αντικείμενο· η σάρωση κατά γραμμές βρίσκει
        // πρώτο το πάνω-αριστερό κελί, που γίνεται το αναγνωριστικό της ομάδας.
        function findGroups(symbol) {
            const seen = new Set();
            const groups = [];
            for (let r = 0; r < ROWS; r++) {
                for (let c = 0; c < COLS; c++) {
                    if (grid[r][c] !== symbol || seen.has(cellKey(c, r))) continue;
                    seen.add(cellKey(c, r));
                    const cells = [];
                    const stack = [[c, r]];
                    while (stack.length) {
                        const cur = stack.pop();
                        cells.push(cur);
                        const nb = [[cur[0], cur[1] - 1], [cur[0], cur[1] + 1],
                                    [cur[0] - 1, cur[1]], [cur[0] + 1, cur[1]]];
                        for (const n of nb) {
                            if (n[0] < 0 || n[1] < 0 || n[0] >= COLS || n[1] >= ROWS) continue;
                            if (grid[n[1]][n[0]] !== symbol) continue;
                            if (seen.has(cellKey(n[0], n[1]))) continue;
                            seen.add(cellKey(n[0], n[1]));
                            stack.push(n);
                        }
                    }
                    cells.sort((a, b) => a[1] !== b[1] ? a[1] - b[1] : a[0] - b[0]);
                    groups.push({ col: c, row: r, cells: cells });
                }
            }
            return groups;
        }

        /// Ξαναϋπολογίζει ομάδες εξόδων ΚΑΙ τηλεμεταφορών και ξαναζωγραφίζει
        /// ετικέτες και πίνακες. Καλείται μετά από κάθε αλλαγή του πλέγματος.
        function syncLinks() {
            if (!grid.length) return;
            syncExits();
            syncTeleports();
        }

        // --- Έξοδοι & αίθουσες ------------------------------------------
        function syncExits() {
            exitGroups = findGroups(EXIT);

            const next = new Map(), nextTwo = new Map(), nextArr = new Map();
            exitGroups.forEach(function (g) {
                // Προορισμός της ομάδας = η πρώτη γνωστή τιμή σε σειρά σάρωσης.
                // Αν ενωθούν δύο ομάδες με διαφορετικούς προορισμούς, κερδίζει η
                // πάνω-αριστερή — μία έξοδος, ένας προορισμός.
                let room = null, two = false, arrive = null;
                for (const cell of g.cells) {
                    const v = exitRooms.get(cellKey(cell[0], cell[1]));
                    if (v !== undefined && v !== null) { room = v; break; }
                }
                for (const cell of g.cells) {
                    if (exitTwo.get(cellKey(cell[0], cell[1]))) { two = true; break; }
                }
                for (const cell of g.cells) {
                    const v = exitArrive.get(cellKey(cell[0], cell[1]));
                    if (v) { arrive = v; break; }
                }
                g.room = room;
                g.twoWay = two;
                g.arrive = arrive;
                g.cells.forEach(function (cell) {
                    const k = cellKey(cell[0], cell[1]);
                    next.set(k, room);
                    nextTwo.set(k, two);
                    nextArr.set(k, arrive);
                });
            });
            exitRooms = next;
            exitTwo = nextTwo;
            exitArrive = nextArr;

            // Αν χάθηκε η ομάδα που περίμενε κλικ (π.χ. σβήστηκε), βγες από την
            // κατάσταση επιλογής αντί να ορίσεις άφιξη σε λάθος σειρά.
            if (pickKind === "exit" && pickIndex >= exitGroups.length) cancelPick(true);
            if (exitHighlight !== null && exitHighlight >= exitGroups.length) exitHighlight = null;

            renderExitLabels();
            renderExitPanel();
            renderExitArrow();
        }

        function renderExitLabels() {
            exitLabels.textContent = "";
            const frag = document.createDocumentFragment();
            exitGroups.forEach(function (g) {
                const text = g.room === null ? "?" : String(g.room);
                g.cells.forEach(function (cell) {
                    const t = document.createElementNS("http://www.w3.org/2000/svg", "text");
                    t.setAttribute("x", cell[0] * CELL + CELL / 2);
                    t.setAttribute("y", cell[1] * CELL + CELL / 2 + 1.8);
                    t.setAttribute("fill", g.room === null ? "#ff5050" : "#ffffff");
                    t.textContent = text;
                    frag.appendChild(t);
                });
            });
            exitLabels.appendChild(frag);
        }

        function renderExitPanel() {
            exitListEl.textContent = "";
            if (!exitGroups.length) {
                const p = document.createElement("div");
                p.className = "hintline";
                p.style.marginTop = "0";
                p.textContent = "No exits. Paint \"Exit\" (X) cells on the grid.";
                exitListEl.appendChild(p);
                renderExitNote();
                return;
            }

            exitGroups.forEach(function (g, i) {
                const row = document.createElement("div");
                row.className = "link-row";
                if (g.room === null) row.classList.add("missing");
                else if (!knownRooms.has(g.room)) row.classList.add("unknown");

                const tag = document.createElement("span");
                tag.className = "link-tag";
                tag.textContent = "#" + (i + 1);

                const pos = document.createElement("span");
                pos.className = "link-pos";
                pos.textContent = "col " + g.col + " row " + g.row + " · " + g.cells.length + " cells";

                const input = document.createElement("input");
                input.type = "number";
                input.min = "1";
                input.step = "1";
                input.placeholder = "room";
                input.title = "Destination room number (file room_<N>.txt)";
                input.value = g.room === null ? "" : String(g.room);
                input.addEventListener("change", function () {
                    const raw = input.value.trim();
                    const n = raw === "" ? null : parseInt(raw, 10);
                    setGroupRoom(i, (n === null || isNaN(n) || n < 0) ? null : n);
                });

                // Το πέρασμα του ποντικιού πάνω από τη σειρά δείχνει πού είναι η
                // έξοδος και πού βγάζει τον παίκτη το σημείο άφιξής της.
                row.addEventListener("mouseenter", function () {
                    exitHighlight = i;
                    renderExitArrow();
                });
                row.addEventListener("mouseleave", function () {
                    if (exitHighlight === i && pickKind === null) exitHighlight = null;
                    renderExitArrow();
                });

                // Διπλής κατεύθυνσης: υπάρχει πόρτα επιστροφής από την άλλη αίθουσα.
                const twoLbl = document.createElement("label");
                twoLbl.className = "link-two";
                twoLbl.title = "Two-way: the other room has a door that "
                             + "leads back here.";
                const twoBox = document.createElement("input");
                twoBox.type = "checkbox";
                twoBox.checked = !!g.twoWay;
                twoBox.addEventListener("change", function () {
                    setGroupTwoWay(i, twoBox.checked);
                });
                twoLbl.append(twoBox, document.createTextNode("two-way"));

                // ΣΗΜΕΙΟ ΑΦΙΞΗΣ: πού στέκεται ο παίκτης ΒΓΑΙΝΟΝΤΑΣ από αυτή την
                // πόρτα. Ανήκει στην πόρτα και όχι στην αίθουσα, γιατί κάθε
                // πόρτα βγάζει αλλού. Κενό = να το βρει μόνο του το παιχνίδι
                // (πρώτο ελεύθερο διπλανό κελί) — που φτάνει μόνο όταν η πόρτα
                // δεν κολλάει σε γωνία.
                const acol = coordInput("arrival column (0.." + (COLS - 1) + ")",
                    g.arrive === null ? "" : String(g.arrive[0]), COLS - 1);
                const arow = coordInput("arrival row (0.." + (ROWS - 1) + ")",
                    g.arrive === null ? "" : String(g.arrive[1]), ROWS - 1);
                function commitArrive() {
                    const c = parseCoord(acol.value), r = parseCoord(arow.value);
                    if (c === null && r === null) { setGroupArrive(i, null); return; }
                    setGroupArrive(i, [c === null ? 0 : c, r === null ? 0 : r]);
                }
                acol.addEventListener("change", commitArrive);
                arow.addEventListener("change", commitArrive);

                const pick = document.createElement("button");
                pick.type = "button";
                pick.className = "pick";
                const picking = pickKind === "exit" && pickIndex === i;
                pick.textContent = picking ? "Cancel" : "Arrival";
                pick.title = "Click on the grid to pick where the player appears "
                           + "coming out of this door (Esc cancels)";
                pick.addEventListener("click", function () {
                    if (picking) cancelPick(); else startPick("exit", i);
                });

                if (picking) row.classList.add("picking");

                const arrBox = document.createElement("span");
                arrBox.className = "link-arr";
                arrBox.append(document.createTextNode("arrival"), acol, arow, pick);

                row.append(tag, pos, input, twoLbl, arrBox);
                exitListEl.appendChild(row);
            });

            renderExitNote();
        }

        /// Το βέλος από την πόρτα προς το σημείο άφιξής της, για τη σειρά που
        /// είναι σε hover ή σε κατάσταση επιλογής.
        function renderExitArrow() {
            exitLinks.textContent = "";
            const i = pickKind === "exit" ? pickIndex : exitHighlight;
            if (i === null) return;
            const g = exitGroups[i];
            if (!g) return;

            const frag = document.createDocumentFragment();
            g.cells.forEach(function (cell) {
                const box = document.createElementNS(SVGNS, "rect");
                box.setAttribute("x", cell[0] * CELL);
                box.setAttribute("y", cell[1] * CELL);
                box.setAttribute("width", CELL);
                box.setAttribute("height", CELL);
                box.setAttribute("fill", "none");
                box.setAttribute("stroke", "#00ff00");
                box.setAttribute("stroke-width", "0.6");
                frag.appendChild(box);
            });

            if (g.arrive !== null) {
                const cs = g.cells.map(p => p[0]), rs = g.cells.map(p => p[1]);
                const x1 = (Math.min(...cs) + Math.max(...cs) + 1) / 2 * CELL;
                const y1 = (Math.min(...rs) + Math.max(...rs) + 1) / 2 * CELL;

                const line = document.createElementNS(SVGNS, "line");
                line.setAttribute("x1", x1); line.setAttribute("y1", y1);
                line.setAttribute("x2", g.arrive[0] * CELL + CELL / 2);
                line.setAttribute("y2", g.arrive[1] * CELL + CELL / 2);
                line.setAttribute("stroke", "#00ff00");
                line.setAttribute("stroke-width", "0.8");
                line.setAttribute("stroke-dasharray", "2 1.5");
                line.setAttribute("marker-end", "url(#exit-arrow)");
                frag.appendChild(line);

                const box = document.createElementNS(SVGNS, "rect");
                box.setAttribute("x", g.arrive[0] * CELL + 0.5);
                box.setAttribute("y", g.arrive[1] * CELL + 0.5);
                box.setAttribute("width", CELL - 1);
                box.setAttribute("height", CELL - 1);
                box.setAttribute("fill", "#00ff00");
                box.setAttribute("fill-opacity", "0.25");
                box.setAttribute("stroke", "#00ff00");
                box.setAttribute("stroke-width", "0.7");
                frag.appendChild(box);
            }

            exitLinks.appendChild(frag);
        }

        /// Γράφει στο σημείωμα ενός πίνακα το πρώτο σφάλμα, αλλιώς την πρώτη
        /// προειδοποίηση που αφορά αυτόν τον πίνακα.
        function renderNote(el, p) {
            if (p.errors.length) {
                el.className = "link-note err";
                el.textContent = p.errors[0];
            } else if (p.warnings.length) {
                el.className = "link-note warn";
                el.textContent = p.warnings[0];
            } else {
                el.className = "link-note";
                el.textContent = "";
            }
        }

        // Ο πίνακας εξόδων κρατάει και το σημείωμα για τον δείκτη εκκίνησης —
        // δεν έχει δικό του πίνακα και είναι λάθος «σε επίπεδο δωματίου», όπως οι έξοδοι.
        function renderExitNote() {
            renderNote(exitNoteEl, merge(exitProblems(), startProblems()));
        }

        function merge() {
            const errors = [], warnings = [];
            for (const p of arguments) {
                errors.push(...p.errors);
                warnings.push(...p.warnings);
            }
            return { errors: errors, warnings: warnings };
        }

        function setGroupRoom(index, room) {
            const g = exitGroups[index];
            if (!g) return;
            g.room = room;
            g.cells.forEach(cell => exitRooms.set(cellKey(cell[0], cell[1]), room));
            dirty = true;
            renderExitLabels();
            renderExitPanel();
        }

        function setGroupTwoWay(index, two) {
            const g = exitGroups[index];
            if (!g) return;
            g.twoWay = two;
            g.cells.forEach(cell => exitTwo.set(cellKey(cell[0], cell[1]), two));
            dirty = true;
            renderExitPanel();
        }

        /// Το κελί όπου εμφανίζεται ο παίκτης ΒΓΑΙΝΟΝΤΑΣ από αυτή την πόρτα.
        /// `arrive` = [col,row] ή null (= υπολόγισέ το μόνος σου, διπλανό κελί).
        function setGroupArrive(index, arrive) {
            const g = exitGroups[index];
            if (!g) return;
            g.arrive = arrive;
            g.cells.forEach(cell => exitArrive.set(cellKey(cell[0], cell[1]), arrive));
            dirty = true;
            renderExitLabels();
            renderExitPanel();
            renderExitArrow();
        }

        // --- Τηλεμεταφορές -----------------------------------------------
        // Η τηλεμεταφορά βγάζει σε ΚΕΛΙ της ίδιας αίθουσας — δεν υπάρχει ζεύγος
        // και δεν χρειάζεται η άλλη άκρη να είναι κι αυτή 'T'. Η ουρά του αρχείου
        // παίρνει μία γραμμή «tp <col> <row> <dcol> <drow>» ανά ομάδα.
        function syncTeleports() {
            teleGroups = findGroups(TELE);

            const next = new Map();
            teleGroups.forEach(function (g) {
                // Προορισμός της ομάδας = η πρώτη γνωστή τιμή σε σειρά σάρωσης,
                // ώστε αν ενωθούν δύο ομάδες να κερδίζει η πάνω-αριστερή.
                let dest = null;
                for (const cell of g.cells) {
                    const v = teleDests.get(cellKey(cell[0], cell[1]));
                    if (v !== undefined && v !== null) { dest = v; break; }
                }
                g.dest = dest;
                g.cells.forEach(cell => next.set(cellKey(cell[0], cell[1]), dest));
            });
            teleDests = next;

            // Αν χάθηκε η ομάδα που περίμενε κλικ (π.χ. σβήστηκε), βγες από την
            // κατάσταση επιλογής αντί να ορίσεις προορισμό σε λάθος σειρά.
            if (pickKind === "tp" && pickIndex >= teleGroups.length) cancelPick(true);
            if (teleHighlight !== null && teleHighlight >= teleGroups.length) teleHighlight = null;

            renderTeleLabels();
            renderTelePanel();
            renderTeleArrow();
        }

        function renderTeleLabels() {
            teleLabels.textContent = "";
            const frag = document.createDocumentFragment();
            teleGroups.forEach(function (g, i) {
                const label = g.dest === null ? "?" : String(i + 1);
                g.cells.forEach(function (cell) {
                    const t = document.createElementNS(SVGNS, "text");
                    t.setAttribute("x", cell[0] * CELL + CELL / 2);
                    t.setAttribute("y", cell[1] * CELL + CELL / 2 + 1.8);
                    t.setAttribute("fill", g.dest === null ? "#ffd000" : "#ffffff");
                    t.textContent = label;
                    frag.appendChild(t);
                });
            });
            teleLabels.appendChild(frag);
        }

        /// Το βέλος από την ομάδα προς το κελί προορισμού, για τη σειρά που είναι
        /// σε hover ή σε κατάσταση επιλογής. Χωρίς επισήμανση δεν ζωγραφίζεται τίποτα.
        function renderTeleArrow() {
            teleLinks.textContent = "";
            const i = pickKind === "tp" ? pickIndex : teleHighlight;
            if (i === null) return;
            const g = teleGroups[i];
            if (!g) return;

            const frag = document.createDocumentFragment();

            // Πλαίσιο γύρω από κάθε κελί της ομάδας — δείχνει ΠΟΙΑ είναι η ομάδα.
            g.cells.forEach(function (cell) {
                const box = document.createElementNS(SVGNS, "rect");
                box.setAttribute("x", cell[0] * CELL);
                box.setAttribute("y", cell[1] * CELL);
                box.setAttribute("width", CELL);
                box.setAttribute("height", CELL);
                box.setAttribute("fill", "none");
                box.setAttribute("stroke", "#ff8000");
                box.setAttribute("stroke-width", "0.6");
                frag.appendChild(box);
            });

            if (g.dest !== null) {
                // Αφετηρία = το κέντρο του περιβάλλοντος ορθογωνίου της ομάδας.
                const cs = g.cells.map(p => p[0]), rs = g.cells.map(p => p[1]);
                const x1 = (Math.min(...cs) + Math.max(...cs) + 1) / 2 * CELL;
                const y1 = (Math.min(...rs) + Math.max(...rs) + 1) / 2 * CELL;
                const x2 = g.dest[0] * CELL + CELL / 2;
                const y2 = g.dest[1] * CELL + CELL / 2;

                const line = document.createElementNS(SVGNS, "line");
                line.setAttribute("x1", x1); line.setAttribute("y1", y1);
                line.setAttribute("x2", x2); line.setAttribute("y2", y2);
                line.setAttribute("stroke", "#ff8000");
                line.setAttribute("stroke-width", "0.8");
                line.setAttribute("stroke-dasharray", "2 1.5");
                line.setAttribute("marker-end", "url(#tp-arrow)");
                frag.appendChild(line);

                const box = document.createElementNS(SVGNS, "rect");
                box.setAttribute("x", g.dest[0] * CELL + 0.5);
                box.setAttribute("y", g.dest[1] * CELL + 0.5);
                box.setAttribute("width", CELL - 1);
                box.setAttribute("height", CELL - 1);
                box.setAttribute("fill", "#ff8000");
                box.setAttribute("fill-opacity", "0.25");
                box.setAttribute("stroke", "#ff8000");
                box.setAttribute("stroke-width", "0.7");
                frag.appendChild(box);
            }

            teleLinks.appendChild(frag);
        }

        function renderTelePanel() {
            teleListEl.textContent = "";
            if (!teleGroups.length) {
                const p = document.createElement("div");
                p.className = "hintline";
                p.style.marginTop = "0";
                p.textContent = "No teleporters. Paint \"Teleporter\" (T) cells on the grid.";
                teleListEl.appendChild(p);
                renderTeleNote();
                return;
            }

            teleGroups.forEach(function (g, i) {
                const row = document.createElement("div");
                row.className = "link-row";
                if (g.dest === null) row.classList.add("pending");
                else if (!inGrid(g.dest[0], g.dest[1])) row.classList.add("missing");
                if (pickKind === "tp" && pickIndex === i) row.classList.add("picking");

                const tag = document.createElement("span");
                tag.className = "link-tag";
                tag.textContent = "#" + (i + 1);

                const pos = document.createElement("span");
                pos.className = "link-pos";
                pos.textContent = "col " + g.col + " row " + g.row + " · " + g.cells.length + " cells";

                // Χειροκίνητη πληκτρολόγηση για ακρίβεια — αλλάζοντας το ένα πεδίο
                // κρατάμε την τιμή του άλλου (ή 0 αν δεν υπάρχει ακόμα προορισμός).
                const dcol = coordInput("destination column (0.." + (COLS - 1) + ")",
                    g.dest === null ? "" : String(g.dest[0]), COLS - 1);
                const drow = coordInput("destination row (0.." + (ROWS - 1) + ")",
                    g.dest === null ? "" : String(g.dest[1]), ROWS - 1);

                function commit() {
                    const c = parseCoord(dcol.value), r = parseCoord(drow.value);
                    if (c === null && r === null) { setGroupDest(i, null); return; }
                    setGroupDest(i, [c === null ? 0 : c, r === null ? 0 : r]);
                }
                dcol.addEventListener("change", commit);
                drow.addEventListener("change", commit);

                const pick = document.createElement("button");
                pick.type = "button";
                pick.className = "pick";
                const picking = pickKind === "tp" && pickIndex === i;
                pick.textContent = picking ? "Cancel" : "Set";
                pick.title = "Click on the grid to pick the destination cell (Esc cancels)";
                pick.addEventListener("click", function () {
                    if (picking) cancelPick(); else startPick("tp", i);
                });

                // Το πέρασμα του ποντικιού πάνω από τη σειρά δείχνει τη σύνδεση.
                row.addEventListener("mouseenter", function () {
                    teleHighlight = i;
                    renderTeleArrow();
                });
                row.addEventListener("mouseleave", function () {
                    if (teleHighlight === i) teleHighlight = null;
                    renderTeleArrow();
                });

                row.append(tag, pos, dcol, drow, pick);
                teleListEl.appendChild(row);
            });

            renderTeleNote();
        }

        function coordInput(title, value, max) {
            const el = document.createElement("input");
            el.type = "number";
            el.className = "coord";
            el.min = "0";
            el.max = String(max);
            el.step = "1";
            el.title = title;
            el.value = value;
            return el;
        }

        function parseCoord(raw) {
            const s = String(raw).trim();
            if (s === "") return null;
            const n = parseInt(s, 10);
            return isNaN(n) ? null : n;
        }

        function inGrid(c, r) { return c >= 0 && r >= 0 && c < COLS && r < ROWS; }

        function renderTeleNote() { renderNote(teleNoteEl, teleProblems()); }

        function setGroupDest(index, dest) {
            const g = teleGroups[index];
            if (!g) return;
            g.dest = dest;
            g.cells.forEach(cell => teleDests.set(cellKey(cell[0], cell[1]), dest));
            dirty = true;
            renderTeleLabels();
            renderTelePanel();
            renderTeleArrow();
        }

        /// Μπαίνει σε κατάσταση «το επόμενο κλικ στο πλέγμα ορίζει το κελί».
        /// `kind` = "tp" (προορισμός τηλεμεταφοράς) ή "exit" (σημείο άφιξης πόρτας).
        function startPick(kind, index) {
            pickKind = kind;
            pickIndex = index;
            svg.classList.add("picking");
            if (kind === "tp") {
                teleHighlight = index;
                const g = teleGroups[index];
                setStatus("Pick the destination cell for teleporter #" + (index + 1) +
                    " (col " + g.col + " row " + g.row + "). Esc to cancel.", "warn");
            } else {
                exitHighlight = index;
                const g = exitGroups[index];
                setStatus("Pick where the player appears coming out of door #" +
                    (index + 1) + " (col " + g.col + " row " + g.row + "). Esc to cancel.", "warn");
            }
            renderTelePanel();
            renderTeleArrow();
            renderExitPanel();
            renderExitArrow();
        }

        function cancelPick(quiet) {
            if (pickKind === null) return;
            const was = pickKind;
            pickKind = null;
            pickIndex = null;
            if (was === "tp") teleHighlight = null; else exitHighlight = null;
            svg.classList.remove("picking");
            if (!quiet) setStatus("Cell selection cancelled.", "info");
            renderTelePanel();
            renderTeleArrow();
            renderExitPanel();
            renderExitArrow();
        }

        // --- Επικύρωση ----------------------------------------------------
        /// Έξοδοι: αδήλωτος προορισμός = σφάλμα (η έξοδος δεν οδηγεί πουθενά),
        /// άγνωστη αίθουσα = προειδοποίηση.
        function exitProblems() {
            const errors = [], warnings = [];
            exitGroups.forEach(function (g, i) {
                const where = "#" + (i + 1) + " (col " + g.col + ", row " + g.row + ")";
                if (g.room === null) {
                    errors.push("Exit " + where + " has no declared destination.");
                } else if (!knownRooms.has(g.room)) {
                    warnings.push("Exit " + where + " leads to room " + g.room +
                        ", which does not exist yet as file room_" + g.room + ".txt.");
                }
            });
            return { errors: errors, warnings: warnings };
        }

        /// Τηλεμεταφορές: χωρίς προορισμό = ΠΡΟΕΙΔΟΠΟΙΗΣΗ (δεν κάνει τίποτα στο
        /// παιχνίδι, ο χρήστης μπορεί να τη συμπληρώσει μετά)· προορισμός εκτός
        /// πλέγματος = ΣΦΑΛΜΑ.
        function teleProblems() {
            const errors = [], warnings = [];
            teleGroups.forEach(function (g, i) {
                const where = "#" + (i + 1) + " (col " + g.col + ", row " + g.row + ")";
                if (g.dest === null) {
                    warnings.push("Teleporter " + where + " has no destination " +
                        "and will do nothing in the game.");
                } else if (!inGrid(g.dest[0], g.dest[1])) {
                    errors.push("Teleporter " + where + " points to cell (" +
                        g.dest[0] + "," + g.dest[1] + "), outside the grid 0.." +
                        (COLS - 1) + " x 0.." + (ROWS - 1) + ".");
                }
            });
            return { errors: errors, warnings: warnings };
        }

        /// Δείκτης εκκίνησης: πάνω από έναν = σφάλμα, κανένας = προειδοποίηση.
        function startProblems() {
            const errors = [], warnings = [];
            let starts = 0;
            for (let r = 0; r < ROWS; r++) {
                for (let c = 0; c < COLS; c++) if (grid[r][c] === START) starts++;
            }
            // ΠΡΟΣΟΧΗ: το διπλό at ("@@") είναι escape του Razor — στο JS φτάνει ένα.
            if (starts > 1) {
                errors.push("There are " + starts + " start markers '@@' — at most one is allowed.");
            } else if (starts === 0) {
                warnings.push("There is no start marker '@@' in the room.");
            }
            return { errors: errors, warnings: warnings };
        }

        /// Επικύρωση πριν την αποθήκευση. Σφάλμα = δεν αποθηκεύουμε·
        /// προειδοποίηση = αποθηκεύουμε αλλά το λέμε.
        function problems() {
            return merge(exitProblems(), teleProblems(), startProblems());
        }

        // --- Αναίρεση --------------------------------------------------
        function snapshot() {
            return grid.map(row => row.join(""));
        }

        function restore(rows) {
            grid = rows.map(line => line.split(""));
            drawAll();
        }

        function pushUndo() {
            undoStack.push(snapshot());
            if (undoStack.length > 100) undoStack.shift();
            redoStack.length = 0;
        }

        function undo() {
            if (!undoStack.length) { setStatus("Nothing to undo.", "info"); return; }
            redoStack.push(snapshot());
            restore(undoStack.pop());
            dirty = true;
        }

        function redo() {
            if (!redoStack.length) { setStatus("Nothing to redo.", "info"); return; }
            undoStack.push(snapshot());
            restore(redoStack.pop());
            dirty = true;
        }

        // --- Ζωγραφική -------------------------------------------------
        // Ξαναϋπολογισμός ομάδων το πολύ μία φορά ανά καρέ, ώστε το σύρσιμο του
        // πινέλου πάνω σε εξόδους να ενημερώνει τις ετικέτες χωρίς να τρέχει η
        // πλημμύρα σε κάθε κελί.
        let linkSyncPending = false;
        function scheduleLinkSync() {
            if (linkSyncPending) return;
            linkSyncPending = true;
            requestAnimationFrame(function () { linkSyncPending = false; syncLinks(); });
        }

        function setCell(r, c, symbol) {
            if (r < 0 || c < 0 || r >= ROWS || c >= COLS) return false;
            const previous = grid[r][c];
            if (previous === symbol) return false;
            grid[r][c] = symbol;
            drawCell(r, c);
            dirty = true;
            if (previous === EXIT || symbol === EXIT ||
                previous === TELE || symbol === TELE) scheduleLinkSync();
            return true;
        }

        function floodFill(r, c, symbol) {
            const target = grid[r][c];
            if (target === symbol) return;
            const stack = [[r, c]];
            while (stack.length) {
                const [y, x] = stack.pop();
                if (y < 0 || x < 0 || y >= ROWS || x >= COLS) continue;
                if (grid[y][x] !== target) continue;
                grid[y][x] = symbol;
                drawCell(y, x);
                stack.push([y + 1, x], [y - 1, x], [y, x + 1], [y, x - 1]);
            }
            dirty = true;
        }

        function borderBox() {
            pushUndo();
            for (let c = 0; c < COLS; c++) { setCell(0, c, SOLID); setCell(ROWS - 1, c, SOLID); }
            for (let r = 0; r < ROWS; r++) { setCell(r, 0, SOLID); setCell(r, COLS - 1, SOLID); }
            refreshSource();
            setStatus("Border box added.", "ok");
        }

        function clearAll() {
            pushUndo();
            for (let r = 0; r < ROWS; r++) {
                for (let c = 0; c < COLS; c++) setCell(r, c, EMPTY);
            }
            refreshSource();
            setStatus("Level cleared.", "ok");
        }

        // --- Ποντίκι ---------------------------------------------------
        function cellFromEvent(ev) {
            const rect = svg.getBoundingClientRect();
            if (!rect.width || !rect.height) return null;
            const c = Math.floor((ev.clientX - rect.left) / rect.width * COLS);
            const r = Math.floor((ev.clientY - rect.top) / rect.height * ROWS);
            if (r < 0 || c < 0 || r >= ROWS || c >= COLS) return null;
            return { r: r, c: c };
        }

        svg.addEventListener("contextmenu", ev => ev.preventDefault());

        svg.addEventListener("pointerdown", function (ev) {
            const p = cellFromEvent(ev);
            if (!p) return;
            ev.preventDefault();

            // ΚΑΤΑΣΤΑΣΗ ΕΠΙΛΟΓΗΣ ΠΡΟΟΡΙΣΜΟΥ: το κλικ ορίζει το κελί και ΔΕΝ ζωγραφίζει.
            // Το δεξί κλικ ακυρώνει, όπως και το Esc.
            if (pickKind !== null) {
                if (ev.button === 2) { cancelPick(); return; }
                const kind = pickKind, i = pickIndex;
                cancelPick(true);
                // Κράτα το βέλος ορατό αμέσως μετά, ως επιβεβαίωση της σύνδεσης.
                if (kind === "tp") {
                    setGroupDest(i, [p.c, p.r]);
                    teleHighlight = i;
                    renderTeleArrow();
                    setStatus("Teleporter #" + (i + 1) + " leads to cell col " +
                        p.c + " row " + p.r + ".", "ok");
                } else {
                    setGroupArrive(i, [p.c, p.r]);
                    exitHighlight = i;
                    renderExitArrow();
                    setStatus("Door #" + (i + 1) + " puts the player at cell col " +
                        p.c + " row " + p.r + ".", "ok");
                }
                return;
            }

            // Δεξί κλικ σβήνει, ανεξάρτητα από το επιλεγμένο εργαλείο.
            const erase = ev.button === 2 || currentTool === "eraser";
            paintSymbol = erase ? EMPTY : currentSymbol;

            if (currentTool === "fill" && !erase) {
                pushUndo();
                floodFill(p.r, p.c, currentSymbol);
                refreshSource();
                return;
            }
            if (currentTool === "fill" && erase) {
                pushUndo();
                floodFill(p.r, p.c, EMPTY);
                refreshSource();
                return;
            }

            pushUndo();
            painting = true;
            svg.setPointerCapture(ev.pointerId);
            setCell(p.r, p.c, paintSymbol);
        });

        svg.addEventListener("pointermove", function (ev) {
            const p = cellFromEvent(ev);
            if (!p) { cursor.setAttribute("visibility", "hidden"); readoutEl.textContent = "—"; return; }
            cursor.setAttribute("x", p.c * CELL);
            cursor.setAttribute("y", p.r * CELL);
            cursor.setAttribute("visibility", "visible");
            const tile = TILE_BY_SYMBOL.get(grid[p.r][p.c]);
            readoutEl.textContent = "col " + p.c + ", row " + p.r +
                "  ·  " + (tile ? tile.name : "?") + " '" + grid[p.r][p.c] + "'" +
                (pickKind === "tp"
                    ? "  ·  click = teleporter destination #" + (pickIndex + 1)
                    : pickKind === "exit"
                    ? "  ·  click = door arrival point #" + (pickIndex + 1)
                    : "");
            if (painting) setCell(p.r, p.c, paintSymbol);
        });

        function endPaint() {
            if (!painting) return;
            painting = false;
            refreshSource();
        }

        svg.addEventListener("pointerup", endPaint);
        svg.addEventListener("pointercancel", endPaint);
        svg.addEventListener("pointerleave", function () {
            cursor.setAttribute("visibility", "hidden");
        });
        window.addEventListener("pointerup", endPaint);

        // --- Παλέτα & εργαλεία ------------------------------------------
        function selectSymbol(symbol) {
            if (!TILE_BY_SYMBOL.has(symbol)) return;
            currentSymbol = symbol;
            document.querySelectorAll(".tile-btn").forEach(b =>
                b.classList.toggle("active", b.dataset.symbol === symbol));
            // Επιλογή τύπου σημαίνει ότι θέλουμε να ζωγραφίσουμε, όχι να σβήσουμε.
            if (currentTool === "eraser") selectTool("brush");
        }

        function selectTool(tool) {
            currentTool = tool;
            document.querySelectorAll(".tool-btn").forEach(b =>
                b.classList.toggle("active", b.dataset.tool === tool));
        }

        document.querySelectorAll(".tile-btn").forEach(b =>
            b.addEventListener("click", () => selectSymbol(b.dataset.symbol)));
        document.querySelectorAll(".tool-btn").forEach(b =>
            b.addEventListener("click", () => selectTool(b.dataset.tool)));

        document.getElementById("btn-border").addEventListener("click", borderBox);
        document.getElementById("btn-clear").addEventListener("click", clearAll);
        document.getElementById("btn-undo").addEventListener("click", undo);
        document.getElementById("btn-redo").addEventListener("click", redo);

        const gridBtn = document.getElementById("btn-gridlines");
        gridBtn.addEventListener("click", function () {
            const on = gridlines.style.display !== "none";
            gridlines.style.display = on ? "none" : "";
            gridBtn.classList.toggle("active", !on);
        });

        // Συντόμευση = ο ΙΔΙΟΣ ο χαρακτήρας του κελιού (π.χ. '#', '/', 'k').
        // Σε ελληνική διάταξη πληκτρολογίου το ev.key δίνει ελληνικό γράμμα, οπότε
        // υπάρχει και εναλλακτική μέσω ev.code (η φυσική θέση του πλήκτρου).
        function latinFromCode(ev) {
            const m = /^Key([A-Z])$/.exec(ev.code);
            if (!m) return null;
            return ev.shiftKey ? m[1] : m[1].toLowerCase();
        }

        document.addEventListener("keydown", function (ev) {
            // Το Esc ακυρώνει την επιλογή προορισμού ακόμα κι αν ο δρομέας είναι
            // μέσα σε πεδίο — γι' αυτό ελέγχεται ΠΡΙΝ από όλα τα άλλα.
            if (ev.key === "Escape" && pickKind !== null) { ev.preventDefault(); cancelPick(); return; }
            if (ev.target.tagName === "INPUT" || ev.target.tagName === "SELECT") return;
            if (ev.ctrlKey && (ev.key === "z" || ev.key === "Z")) { ev.preventDefault(); undo(); return; }
            if (ev.ctrlKey && (ev.key === "y" || ev.key === "Y")) { ev.preventDefault(); redo(); return; }
            if (ev.ctrlKey || ev.altKey || ev.metaKey) return;
            if (TILE_BY_SYMBOL.has(ev.key)) { selectSymbol(ev.key); return; }
            const latin = latinFromCode(ev);
            if (latin && TILE_BY_SYMBOL.has(latin)) selectSymbol(latin);
        });

        // --- Αρχεία -----------------------------------------------------
        function loadDocument(dto) {
            grid = dto.rows.map(line => line.split(""));
            header = dto.header || [];
            footer = dto.footer || [];
            // Ο server δίνει τους προορισμούς στο αναγνωριστικό κάθε ομάδας· το
            // syncLinks() (μέσω του drawAll) τους απλώνει σε όλα τα κελιά της.
            exitRooms = new Map();
            exitTwo = new Map();
            exitArrive = new Map();
            (dto.exits || []).forEach(function (e) {
                const k = cellKey(e.col, e.row);
                exitRooms.set(k, (e.room === undefined) ? null : e.room);
                exitTwo.set(k, !!e.twoWay);
                exitArrive.set(k, (e.arriveCol === null || e.arriveCol === undefined ||
                                   e.arriveRow === null || e.arriveRow === undefined)
                    ? null : [e.arriveCol, e.arriveRow]);
            });
            teleDests = new Map();
            (dto.teleports || []).forEach(function (t) {
                const dest = (t.destCol === null || t.destCol === undefined ||
                              t.destRow === null || t.destRow === undefined)
                    ? null : [t.destCol, t.destRow];
                teleDests.set(cellKey(t.col, t.row), dest);
            });
            cancelPick(true);
            teleHighlight = null;
            undoStack.length = 0;
            redoStack.length = 0;
            dirty = false;
            drawAll();
        }

        async function readError(res) {
            try {
                const body = await res.json();
                return body.error || ("Error " + res.status);
            } catch (e) {
                return "Error " + res.status;
            }
        }

        async function refreshFileList(selectName) {
            const res = await fetch("/api/levels");
            if (!res.ok) return;
            const body = await res.json();
            fileList.innerHTML = "";
            knownRooms = new Set();
            body.files.forEach(function (f) {
                const opt = document.createElement("option");
                opt.value = f.name;
                // Οι αίθουσες φαίνονται με τον αριθμό τους· η σειρά έρχεται από τον
                // server (αριθμητικά: room_2 πριν το room_10).
                opt.textContent = (f.room === null || f.room === undefined)
                    ? f.name : ("Room " + f.room + " — " + f.name);
                fileList.appendChild(opt);
                if (f.room !== null && f.room !== undefined) knownRooms.add(f.room);
            });
            if (selectName) fileList.value = selectName;
            if (exitGroups.length) renderExitPanel();
        }

        async function openLevel(name) {
            if (!name) { setStatus("No level to open.", "err"); return; }
            if (dirty && !confirm("There are unsaved changes. Continue?")) return;
            const res = await fetch("/api/levels/" + encodeURIComponent(name));
            if (!res.ok) { setStatus(await readError(res), "err"); return; }
            loadDocument(await res.json());
            fileName.value = name;
            setStatus("Loaded level \"" + name + "\".", "ok");
        }

        async function newLevel() {
            if (dirty && !confirm("There are unsaved changes. Continue?")) return;
            const res = await fetch("/api/levels/new");
            if (!res.ok) { setStatus(await readError(res), "err"); return; }
            loadDocument(await res.json());
            fileName.value = "";
            setStatus("New empty level with a border.", "ok");
        }

        async function newRoom() {
            if (dirty && !confirm("There are unsaved changes. Continue?")) return;
            const res = await fetch("/api/levels/room", { method: "POST" });
            if (!res.ok) { setStatus(await readError(res), "err"); return; }
            const dto = await res.json();
            loadDocument(dto);
            await refreshFileList(dto.name);
            fileName.value = dto.name;
            setStatus("Created room " + dto.room + " (" + dto.name + ").", "ok");
        }

        async function saveLevel() {
            cancelPick(true);
            const name = fileName.value.trim();
            if (!name) { setStatus("Enter a file name.", "err"); return; }

            // ΕΠΙΚΥΡΩΣΗ πριν σταλεί οτιδήποτε: τα σφάλματα σταματούν την αποθήκευση,
            // οι προειδοποιήσεις ζητούν απλώς επιβεβαίωση.
            const p = problems();
            if (p.errors.length) {
                setStatus("Not saved — " + p.errors.join(" "), "err");
                return;
            }
            if (p.warnings.length && !confirm(p.warnings.join("\n") + "\n\nSave anyway?")) return;

            const payload = {
                name: name,
                rows: grid.map(row => row.join("")),
                header: header,
                footer: footer,
                exits: exitGroups.map(g => ({
                    col: g.col, row: g.row, room: g.room, cells: g.cells.length,
                    twoWay: !!g.twoWay,
                    arriveCol: g.arrive === null ? null : g.arrive[0],
                    arriveRow: g.arrive === null ? null : g.arrive[1],
                })),
                // Μία εγγραφή ανά ΟΜΑΔΑ — ο server γράφει μία γραμμή «tp …» για
                // όσες έχουν προορισμό και παραλείπει τις υπόλοιπες.
                teleports: teleGroups.map(g => ({
                    col: g.col, row: g.row,
                    destCol: g.dest === null ? null : g.dest[0],
                    destRow: g.dest === null ? null : g.dest[1],
                    cells: g.cells.length,
                })),
            };
            const res = await fetch("/api/levels", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(payload),
            });
            if (!res.ok) { setStatus(await readError(res), "err"); return; }
            const body = await res.json();
            dirty = false;
            await refreshFileList(body.saved);
            fileName.value = body.saved;
            const warn = (body.warnings && body.warnings.length)
                ? " — " + body.warnings.join(" ") : "";
            setStatus("Saved: " + body.saved + warn, warn ? "warn" : "ok");
        }

        document.getElementById("btn-open").addEventListener("click", () => openLevel(fileList.value));
        document.getElementById("btn-new").addEventListener("click", newLevel);
        document.getElementById("btn-new-room").addEventListener("click", newRoom);
        document.getElementById("btn-save").addEventListener("click", saveLevel);

        // --- Δοκιμή και χτίσιμο ------------------------------------------
        // Και τα δύο τρέχουν πάνω στο ΑΠΟΘΗΚΕΥΜΕΝΟ αρχείο, όχι στο πλέγμα της
        // οθόνης: δοκιμάζεις ακριβώς ό,τι θα παίξει, χωρίς να μπερδεύεσαι με
        // αλλαγές που δεν έχεις σώσει.
        function roomNumberOfName(name) {
            const m = /^room_(\d+)\.txt$/i.exec(name || "");
            return m ? parseInt(m[1], 10) : 0;
        }

        // --- Αντιγραφή / μετακίνηση αίθουσας -----------------------------
        async function roomOp(url, body, okMsg) {
            const res = await fetch(url, {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify(body)
            });
            const b = await res.json();
            if (!res.ok) { setStatus(b.error || "Failed.", "err"); return null; }
            await refreshFileList();
            return b;
        }

        document.getElementById("btn-copy-room").addEventListener("click", async function () {
            const n = roomNumberOfName(fileName.value.trim());
            if (!n) { setStatus("Open a room first (room_<N>.txt).", "err"); return; }
            if (dirty && !confirm("There are unsaved changes. The SAVED file will be copied. Continue?")) return;
            const b = await roomOp("/api/levels/room/copy", { from: n });
            if (!b) return;
            loadDocument(b);
            fileName.value = b.name;
            fileList.value = b.name;
            setStatus("Copied as \"" + b.name + "\". No door points to it yet.", "ok");
        });

        document.getElementById("btn-move-room").addEventListener("click", async function () {
            const n = roomNumberOfName(fileName.value.trim());
            if (!n) { setStatus("Open a room first (room_<N>.txt).", "err"); return; }
            if (dirty) { setStatus("Save first: Move works on the files.", "err"); return; }
            // Πεδίο και όχι prompt(): το prompt() το μπλοκάρουν οι browsers σε
            // διάφορες περιπτώσεις και το κουμπί έμοιαζε νεκρό.
            const target = document.getElementById("room-target");
            const to = parseInt(target.value.trim(), 10);
            if (!to || to < 1 || to > 9999) {
                setStatus("Type the new room number in the field next to it first.", "err");
                target.focus();
                return;
            }
            const b = await roomOp("/api/levels/room/move", { from: n, to: to });
            if (!b) return;
            loadDocument(b.dto);
            fileName.value = b.name;
            fileList.value = b.name;
            // Δείξε ΤΙ ενημερώθηκε: ο χρήστης πρέπει να ξέρει ότι πειράχτηκαν
            // και άλλα αρχεία, όχι μόνο αυτό που είχε ανοιχτό.
            document.getElementById("room-target").value = "";
            setStatus("Moved to " + to + ". " + (b.touched || []).join(" · "), "ok");
        });

        document.getElementById("btn-play").addEventListener("click", function () {
            const name = fileName.value.trim();
            if (!name) {
                setStatus("Open or save a room first.", "err");
                return;
            }
            if (dirty) setStatus("Note: the test run uses the saved file.");
            window.open("/game/play.html?level=" + encodeURIComponent(name), "_blank");
        });

        document.getElementById("btn-dsk").addEventListener("click", async function (ev) {
            const room = roomNumberOfName(fileName.value.trim());
            if (!room) {
                setStatus("The .dsk starts from a room — open a room_<N>.txt.", "err");
                return;
            }
            const btn = ev.currentTarget;
            btn.disabled = true;
            setStatus("Building for room " + room + "…");
            try {
                const res = await fetch("/api/build", {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({ room: room })
                });
                const b = await res.json();
                setStatus(b.ok
                    ? "Ready: " + b.dsk + " (" + b.bytes + " bytes), room " + room
                    : "Build failed: " + (b.output || b.error || ""),
                    b.ok ? "ok" : "err");
            } catch (e) {
                setStatus("Build error: " + e, "err");
            } finally {
                btn.disabled = false;
            }
        });

        window.addEventListener("beforeunload", function (ev) {
            if (!dirty) return;
            ev.preventDefault();
            ev.returnValue = "";
        });

        // --- Εκκίνηση ---------------------------------------------------
        buildGrid();
        selectSymbol(SOLID);
        selectTool("brush");

        // Πρώτα η λίστα αρχείων: από εκεί μαθαίνουμε ποιες αίθουσες υπάρχουν, ώστε
        // ο έλεγχος προορισμού να ξέρει τι να προειδοποιήσει.
        (async function () {
            await refreshFileList(fileList.value);
            if (fileList.options.length > 0) await openLevel(fileList.value);
            else await newLevel();
        })();
    })();
</script>
